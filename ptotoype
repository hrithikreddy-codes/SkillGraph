<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PathFinder - Your Career Roadmap</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #1f2937;
        }

        header {
            background: #111827;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 24px;
        }

        header span {
            color: #60a5fa;
        }

        .hero {
            text-align: center;
            padding: 70px 20px 45px;
            background: linear-gradient(135deg, #111827, #1e3a8a);
            color: white;
        }

        .hero h2 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #dbeafe;
            max-width: 650px;
            margin: auto;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            margin-bottom: 30px;
        }

        .card h3 {
            margin-bottom: 25px;
            font-size: 24px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

        input,
        select {
            width: 100%;
            padding: 13px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            font-size: 15px;
        }

        .checkbox-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .checkbox {
            border: 1px solid #d1d5db;
            padding: 12px;
            border-radius: 10px;
            cursor: pointer;
        }

        .checkbox:hover {
            background: #eff6ff;
        }

        button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: white;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }

        #roadmap {
            display: none;
        }

        .career-title {
            font-size: 30px;
            margin-bottom: 10px;
            color: #1d4ed8;
        }

        .summary {
            background: #eff6ff;
            padding: 18px;
            border-radius: 12px;
            margin: 20px 0;
        }

        .roadmap-step {
            position: relative;
            padding: 20px;
            margin: 15px 0;
            border-left: 5px solid #2563eb;
            background: #f9fafb;
            border-radius: 0 12px 12px 0;
        }

        .roadmap-step h4 {
            color: #111827;
            margin-bottom: 8px;
            font-size: 19px;
        }

        .roadmap-step p {
            color: #4b5563;
            line-height: 1.6;
        }

        .tag {
            display: inline-block;
            padding: 6px 10px;
            background: #dbeafe;
            color: #1e40af;
            border-radius: 20px;
            margin: 5px 3px;
            font-size: 13px;
        }

        footer {
            text-align: center;
            padding: 30px;
            color: #6b7280;
        }

        @media(max-width: 600px) {
            .hero h2 {
                font-size: 30px;
            }

            .checkbox-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Path<span>Finder</span></h1>
    <p>Build Your Future</p>
</header>


<section class="hero">

    <h2>Don't Guess Your Career.</h2>

    <p>
        Tell us about yourself and we'll create a step-by-step
        roadmap to help you understand what to learn, build and do next.
    </p>

</section>


<div class="container">

    <!-- INPUT FORM -->

    <div class="card">

        <h3>🎯 Create Your Career Roadmap</h3>

        <div class="form-group">

            <label>What are you currently studying?</label>

            <select id="education">

                <option value="">Select your level</option>

                <option>School</option>
                <option>Intermediate / 12th</option>
                <option>B.Tech / Engineering</option>
                <option>Degree</option>
                <option>Diploma</option>
                <option>Other</option>

            </select>

        </div>


        <div class="form-group">

            <label>What area interests you?</label>

            <select id="interest">

                <option value="">Select an interest</option>

                <option value="software">Software Development</option>
                <option value="ai">Artificial Intelligence</option>
                <option value="data">Data Science</option>
                <option value="cyber">Cybersecurity</option>
                <option value="design">UI/UX Design</option>
                <option value="business">Business / Entrepreneurship</option>

            </select>

        </div>


        <div class="form-group">

            <label>What is your main strength?</label>

            <div class="checkbox-grid">

                <div class="checkbox">
                    <input type="checkbox" value="problem">
                    Problem Solving
                </div>

                <div class="checkbox">
                    <input type="checkbox" value="creative">
                    Creativity
                </div>

                <div class="checkbox">
                    <input type="checkbox" value="communication">
                    Communication
                </div>

                <div class="checkbox">
                    <input type="checkbox" value="math">
                    Mathematics
                </div>

            </div>

        </div>


        <div class="form-group">

            <label>What career do you want to explore?</label>

            <input
                type="text"
                id="career"
                placeholder="Example: AI Engineer"
            >

        </div>


        <button onclick="generateRoadmap()">
            Generate My Roadmap →
        </button>

    </div>


    <!-- ROADMAP -->

    <div class="card" id="roadmap">

        <h3>Your Personalized Roadmap</h3>

        <div class="summary">

            <div class="career-title" id="careerName">
                AI Engineer
            </div>

            <p id="studentSummary"></p>

        </div>


        <div class="roadmap-step">

            <h4>01 — Build Your Foundation</h4>

            <p>
                Start with the fundamentals required for your field.
                Focus on programming basics, logical thinking,
                mathematics and computer fundamentals.
            </p>

            <div>
                <span class="tag">Programming</span>
                <span class="tag">Logic</span>
                <span class="tag">Computer Fundamentals</span>
            </div>

        </div>


        <div class="roadmap-step">

            <h4>02 — Learn Core Skills</h4>

            <p id="coreSkills">
                Develop the technical skills commonly used in your
                chosen career.
            </p>

        </div>


        <div class="roadmap-step">

            <h4>03 — Build Real Projects</h4>

            <p>
                Don't only watch tutorials. Build projects that
                demonstrate what you have learned.
            </p>

            <div>
                <span class="tag">Mini Projects</span>
                <span class="tag">GitHub</span>
                <span class="tag">Portfolio</span>
            </div>

        </div>


        <div class="roadmap-step">

            <h4>04 — Gain Experience</h4>

            <p>
                Participate in hackathons, open-source projects,
                internships and college technical communities.
            </p>

        </div>


        <div class="roadmap-step">

            <h4>05 — Prepare for Your Career</h4>

            <p>
                Build your resume, improve interview skills,
                practice technical questions and create a strong
                professional portfolio.
            </p>

        </div>


        <div class="roadmap-step">

            <h4>🚀 Your Long-Term Goal</h4>

            <p>
                Continue learning, specialize in a domain and
                regularly update your skills as the industry changes.
            </p>

        </div>

    </div>

</div>


<footer>

    PathFinder © 2026 — Helping students find their direction.

</footer>


<script>

function generateRoadmap() {

    const education =
        document.getElementById("education").value;

    const interest =
        document.getElementById("interest").value;

    const career =
        document.getElementById("career").value;


    if (!education || !interest || !career) {

        alert("Please fill in all the required fields.");

        return;

    }


    document.getElementById("roadmap").style.display = "block";


    document.getElementById("careerName").innerText =
        career;


    document.getElementById("studentSummary").innerText =
        `Based on your current level (${education})
        and your interest in ${interest},
        here is a suggested starting roadmap for exploring
        ${career}.`;


    const skills = {

        software:
            "Learn C/C++, Python or Java, data structures, algorithms, Git, databases and web/application development.",

        ai:
            "Learn Python, mathematics, statistics, machine learning, neural networks, data handling and AI frameworks.",

        data:
            "Learn Python, SQL, statistics, data visualization, Excel, data analysis and machine learning.",

        cyber:
            "Learn networking, Linux, operating systems, security fundamentals, cryptography and ethical security practices.",

        design:
            "Learn design principles, typography, color theory, Figma, user research, wireframing and prototyping.",

        business:
            "Learn business fundamentals, market research, communication, finance, marketing and product development."

    };


    document.getElementById("coreSkills").innerText =
        skills[interest];


    window.scrollTo({

        top: document.getElementById("roadmap").offsetTop - 30,

        behavior: "smooth"

    });

}

</script>

</body>
</html>
